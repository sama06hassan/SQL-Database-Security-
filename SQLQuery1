/*
How the attack works:
Every database user is automatically a member of the PUBLIC role, so general
inherits the SELECT permission on vw_EmployeeDirectory.
The view and the Employees table have the same owner (dbo), so because of
ownership chaining SQL Server checks the permission on the view only and does
not check the permissions on Employees.
That is why the DENY on Employees for public_role is skipped and general can
read FullName, Salary and Bonus through the view.

How to fix it:

Revoke the permission from PUBLIC.

Remove the sensitive columns from the view (mask the name, drop Salary and Bonus).

Grant the view to specific roles only, never to PUBLIC.
*/

REVOKE SELECT ON dbo.vw_EmployeeDirectory FROM public;
GO

ALTER VIEW dbo.vw_EmployeeDirectory
AS
SELECT
LEFT(e.FullName, 1) + REPLICATE('*', LEN(e.FullName) - 1) AS MaskedName,
e.Dept,
e.Title,
d.Location,
d.Phone
FROM dbo.Employees AS e
JOIN dbo.DeptDirectory AS d ON d.Dept = e.Dept;
GO

GRANT SELECT ON dbo.vw_EmployeeDirectory TO public_role;
GO

EXECUTE AS USER = 'general';
SELECT USER_NAME() AS CurrentUser;
SELECT * FROM dbo.vw_EmployeeDirectory;
REVERT;
GO

