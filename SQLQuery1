/* =========================================================
PART 3 - Functional Dependency Inference
Database: CompanySecurityDB
Table: Employees
========================================================= */

USE CompanySecurityDB;
GO

/* =========================================================
GIVEN FUNCTIONAL DEPENDENCIES
========================================================= */

/*
FD1: EmpID -> Dept
FD2: Title -> Grade
FD3: Dept, Grade -> Bonus

Students must:

Compute closure Q+ of {Dept, Title}.

Show Bonus ∈ Q+.

Decide whether to reject or transform the query.
*/

/* =========================================================
CREATE PUBLIC VIEW
========================================================= */

IF OBJECT_ID('dbo.vw_EmployeesPublic', 'V') IS NOT NULL
DROP VIEW dbo.vw_EmployeesPublic;
GO

CREATE VIEW dbo.vw_EmployeesPublic
AS
SELECT
EmpID,
FullName,
Dept
FROM dbo.Employees;
GO

/* =========================================================
GRANT ACCESS TO THE VIEW
========================================================= */

GRANT SELECT ON dbo.vw_EmployeesPublic TO public_role;
GO

/* =========================================================
PART 3 - CLOSURE OF {Dept, Title}
========================================================= */
/*
Initial:
Q+ = {Dept, Title}

FD1:
EmpID -> Dept
EmpID is not in Q+, so FD1 adds nothing

FD2:
Title -> Grade

Therefore:
Q+ = {Dept, Title, Grade}

FD3:
Dept, Grade -> Bonus

Therefore:
Q+ = {Dept, Title, Grade, Bonus}

So:
Bonus ∈ Q+
*/
/* =========================================================
SHOW THE CLOSURE
========================================================= */

SELECT
'Dept' AS Attribute
UNION ALL
SELECT
'Title'
UNION ALL
SELECT
'Grade'
UNION ALL
SELECT
'Bonus';
GO
/* =========================================================
SHOW BONUS
========================================================= */

SELECT
Dept,
Title,
Bonus
FROM dbo.Employees;
GO
/* =========================================================
DECISION - TRANSFORM QUERY
========================================================= */
/*
Because Bonus is inferable from {Dept, Title}
using the given Functional Dependencies,
exposing Dept and Title together with Bonus
creates an inference channel.

Therefore, the query should be TRANSFORMED
rather than simply rejected.

We return only non-sensitive attributes.
Title is removed, so the closure is {EmpID, FullName, Dept}
and Bonus is not in it.
*/
SELECT
EmpID,
FullName,
Dept
FROM dbo.Employees;
GO
/* =========================================================
TRY ACCESS AS EMPLOYEE
========================================================= */
EXECUTE AS USER = 'general';

SELECT USER_NAME() AS CURRENT_NAME;

-- Expected: SUCCEEDED
SELECT
    EmpID,
    FullName,
    Dept
FROM dbo.vw_EmployeesPublic;

REVERT;
GO

/* =========================================
Part 4 - Inference via Aggregates
========================================= */

/* 1. AVG views including and excluding the target user (EmpID 6 = Ahmed) */
CREATE OR ALTER VIEW dbo.vw_AvgSalary_All
AS
SELECT COUNT(*) AS EmpCount, AVG(Salary) AS AVG_ALL
FROM dbo.Employees;
GO

CREATE OR ALTER VIEW dbo.vw_AvgSalary_WithoutTarget
AS
SELECT COUNT(*) AS EmpCount, AVG(Salary) AS AVG_Without_Target
FROM dbo.Employees
WHERE EmpID <> 6;
GO

GRANT SELECT ON dbo.vw_AvgSalary_All           TO public_role;
GRANT SELECT ON dbo.vw_AvgSalary_WithoutTarget TO public_role;
GO

/* The attack: the public user infers the target salary from the two views */
EXECUTE AS USER = 'general';

SELECT USER_NAME() AS CurrentUser;

SELECT * FROM dbo.vw_AvgSalary_All;            -- 6 employees, AVG 95000
SELECT * FROM dbo.vw_AvgSalary_WithoutTarget;  -- 5 employees, AVG 100000

-- Expected: 70000 (Ahmed's salary)
SELECT a.EmpCount * a.AVG_ALL - w.EmpCount * w.AVG_Without_Target AS Inferred_Salary
FROM dbo.vw_AvgSalary_All AS a
CROSS JOIN dbo.vw_AvgSalary_WithoutTarget AS w;

REVERT;
GO

/* 2. Apply K-anonymity rule (k = 2)
A result is returned only if:
- it covers at least k employees
- and the employees left out are 0 or at least k
So no single employee can be found by subtracting two results. */
ALTER VIEW dbo.vw_AvgSalary_All
AS
SELECT COUNT(*) AS EmpCount, AVG(Salary) AS AVG_ALL
FROM dbo.Employees
HAVING COUNT(*) >= 2
AND ((SELECT COUNT(*) FROM dbo.Employees) - COUNT(*) = 0
  OR (SELECT COUNT(*) FROM dbo.Employees) - COUNT(*) >= 2);
GO

ALTER VIEW dbo.vw_AvgSalary_WithoutTarget
AS
SELECT COUNT(*) AS EmpCount, AVG(Salary) AS AVG_Without_Target
FROM dbo.Employees
WHERE EmpID <> 6
HAVING COUNT(*) >= 2
AND ((SELECT COUNT(*) FROM dbo.Employees) - COUNT(*) = 0
  OR (SELECT COUNT(*) FROM dbo.Employees) - COUNT(*) >= 2);
GO

/* 3. Demonstrate that inference is blocked */
EXECUTE AS USER = 'general';

SELECT USER_NAME() AS CurrentUser;

-- Expected: 6 employees, AVG 95000 (nobody left out)
SELECT * FROM dbo.vw_AvgSalary_All;

-- Expected: no rows (only 1 employee left out -> blocked)
SELECT * FROM dbo.vw_AvgSalary_WithoutTarget;

-- Expected: no rows -> the target salary can not be inferred
SELECT a.EmpCount * a.AVG_ALL - w.EmpCount * w.AVG_Without_Target AS Inferred_Salary
FROM dbo.vw_AvgSalary_All AS a
CROSS JOIN dbo.vw_AvgSalary_WithoutTarget AS w;

REVERT;
GO
